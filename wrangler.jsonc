// Cloudflare Workers static assets for mobilehtml5.stungeye.com (PLAN C4, F41). See README "Hosting".
{
  "name": "static-mobilehtml5-stungeye-com",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,  // on until the cutover is checked (then false, R11)
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Cutover, owner-confirmed 2026-10-31 (PLAN F44), over the proxied *.stungeye.com wildcard. Rollback: remove this and push, or delete the route in the dashboard.
  "routes": [{ "pattern": "mobilehtml5.stungeye.com/*", "zone_name": "stungeye.com" }]
}
